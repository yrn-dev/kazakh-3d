# Include the current portable project, not abandoned map experiments.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CREDITS.txt
!/PROJECT_REQUIREMENTS.txt
!/asset-manifest.json
!/run
!/run-walk
!/run.bat
!/run-walk.bat
!/godot/
!/blender/
!/source/
!/scripts/
!/previews/
!/research/

/blender/*
!/blender/modern_city_enclosed.blend
!/blender/modern_city_block.blend
!/blender/characters/
/source/*
!/source/modern_city_block.glb
!/source/characters/
!/source/enclosure_stats.json
!/source/modern_city_stats.json
/scripts/*
!/scripts/prepare_modern_city.py
!/scripts/extend_modern_city.py
!/scripts/import_characters.py
!/scripts/retarget_walk.py
!/scripts/finalize_walk_glb.py
!/scripts/check_walk.py
!/scripts/build_pedestrian_grid.py
!/scripts/build_pedestrian_routes.py
!/scripts/verify_assets.py
!/scripts/requirements.txt
/previews/*
!/previews/npcs_city_street.png
!/previews/npcs_jane_sidewalk.png
!/previews/enclosed_overview.png
!/previews/npc_routes.png
!/previews/walk_phase_1.png
/research/*
!/research/character_file_audit.json
!/research/pedestrian_grid.npz
!/research/npc_validation.json
!/research/walk_validation.json
!/research/walk_retarget_report.json

**/.godot/
**/__pycache__/
*.pyc
*.blend[0-9]
*.bak
*.log
.DS_Store
.env
.env.*
# Godot regenerates these embedded textures from the committed GLBs.
/godot/assets/*_Image_*.png*
/godot/assets/characters/*_Image_*.png*
/godot/assets/modern_city_block*
/godot/assets/almaty_district*

/godot/assets/**/*.jpg*
/godot/assets/characters/*.png*
